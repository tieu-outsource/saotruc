# Telegram bot credentials for the contact form.
# 1. Create a bot with @BotFather on Telegram, copy the token.
# 2. Get your chat id: send a message to the bot, then visit
#    https://api.telegram.org/bot<TOKEN>/getUpdates and read the "chat":{"id":...} value.
# 3. Copy this file to .env.local and fill in the values (local dev only).
# For production, set the same variables in the Vercel project settings.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
